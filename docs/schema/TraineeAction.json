{
  "$defs": {
    "ActionType": {
      "description": "Everything a trainee (or the oracle) can do.",
      "enum": [
        "ACK_TRACK",
        "CLASSIFY",
        "SET_PRIORITY",
        "STEER_SENSOR",
        "WARN",
        "ENGAGE_S",
        "ENGAGE_H",
        "HOLD_FIRE",
        "REQUEST_ID",
        "PAUSE_REQUEST"
      ],
      "title": "ActionType",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One trainee decision, as stored in the action log.\n\nThe ordered log plus the seed *is* the determinism contract.",
  "properties": {
    "params": {
      "title": "Params",
      "type": "object"
    },
    "schema_version": {
      "default": 3,
      "description": "Wire schema version; unknown versions are rejected at the boundary.",
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source": {
      "default": "trainee",
      "enum": [
        "trainee",
        "oracle",
        "scripted",
        "instructor"
      ],
      "title": "Source",
      "type": "string"
    },
    "t": {
      "minimum": 0.0,
      "title": "T",
      "type": "number"
    },
    "track_id": {
      "anyOf": [
        {
          "maxLength": 48,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Track Id"
    },
    "type": {
      "$ref": "#/$defs/ActionType"
    }
  },
  "required": [
    "t",
    "type"
  ],
  "title": "TraineeAction",
  "type": "object",
  "x-skygym-schema-version": 3
}