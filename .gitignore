# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
htmlcov/
.coverage

# Node / frontend
node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/
frontend/test-results/
frontend/playwright-report/
# `tsc -b` emits these next to the config files it compiles.
frontend/*.tsbuildinfo
frontend/vite.config.js
frontend/vite.config.d.ts
frontend/vitest.config.js
frontend/vitest.config.d.ts
frontend/playwright.config.js
frontend/playwright.config.d.ts
# The browser's python bundle and the vendored pyodide runtime.
# Both are build artefacts: `npm run sync:core` regenerates them from
# node_modules and backend/app/core.
frontend/public/pyapp/
frontend/public/pyodide/

# Runtime data (regenerated by `make seed`)
backend/data/*.db
backend/data/*.db-wal
backend/data/*.db-shm
backend/data/*.zip
backend/data/logs/
backend/data/migrations_tmp/
backend/data/.devpids
backend/artifacts/

# Dev-server console output (scripts/dev_start.py)
uvicorn.err
uvicorn.log
vite.err
vite.log

# Editors / OS
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# Local env
.env
.env.local

# Vercel CLI project link
.vercel/
# Regenerated UI screenshots (frontend/shots.cjs)
frontend/shots/
