{
  "$defs": {
    "ActionType": {
      "description": "Everything a trainee (or the oracle) can do.",
      "enum": [
        "ACK_TRACK",
        "CLASSIFY",
        "SET_PRIORITY",
        "STEER_SENSOR",
        "WARN",
        "ENGAGE_S",
        "ENGAGE_H",
        "HOLD_FIRE",
        "REQUEST_ID",
        "PAUSE_REQUEST"
      ],
      "title": "ActionType",
      "type": "string"
    },
    "GhostAction": {
      "additionalProperties": false,
      "description": "What the oracle would have done.",
      "properties": {
        "entity_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity Id"
        },
        "params": {
          "title": "Params",
          "type": "object"
        },
        "rationale": {
          "default": "",
          "title": "Rationale",
          "type": "string"
        },
        "schema_version": {
          "default": 3,
          "description": "Wire schema version; unknown versions are rejected at the boundary.",
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "t": {
          "title": "T",
          "type": "number"
        },
        "track_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Track Id"
        },
        "type": {
          "$ref": "#/$defs/ActionType"
        }
      },
      "required": [
        "t",
        "type"
      ],
      "title": "GhostAction",
      "type": "object"
    },
    "TraineeAction": {
      "additionalProperties": false,
      "description": "One trainee decision, as stored in the action log.\n\nThe ordered log plus the seed *is* the determinism contract.",
      "properties": {
        "params": {
          "title": "Params",
          "type": "object"
        },
        "schema_version": {
          "default": 3,
          "description": "Wire schema version; unknown versions are rejected at the boundary.",
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source": {
          "default": "trainee",
          "enum": [
            "trainee",
            "oracle",
            "scripted",
            "instructor"
          ],
          "title": "Source",
          "type": "string"
        },
        "t": {
          "minimum": 0.0,
          "title": "T",
          "type": "number"
        },
        "track_id": {
          "anyOf": [
            {
              "maxLength": 48,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Track Id"
        },
        "type": {
          "$ref": "#/$defs/ActionType"
        }
      },
      "required": [
        "t",
        "type"
      ],
      "title": "TraineeAction",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The outcome of a counterfactual fork.",
  "properties": {
    "diverged": {
      "title": "Diverged",
      "type": "boolean"
    },
    "explanation": {
      "default": "",
      "title": "Explanation",
      "type": "string"
    },
    "fork_t": {
      "title": "Fork T",
      "type": "number"
    },
    "forked_hash": {
      "title": "Forked Hash",
      "type": "string"
    },
    "forked_outcome": {
      "title": "Forked Outcome",
      "type": "object"
    },
    "forked_score": {
      "title": "Forked Score",
      "type": "number"
    },
    "ghost_actions": {
      "items": {
        "$ref": "#/$defs/GhostAction"
      },
      "title": "Ghost Actions",
      "type": "array"
    },
    "newly_appended_actions": {
      "items": {
        "$ref": "#/$defs/TraineeAction"
      },
      "title": "Newly Appended Actions",
      "type": "array"
    },
    "original_hash": {
      "title": "Original Hash",
      "type": "string"
    },
    "original_outcome": {
      "title": "Original Outcome",
      "type": "object"
    },
    "original_score": {
      "title": "Original Score",
      "type": "number"
    },
    "schema_version": {
      "default": 3,
      "description": "Wire schema version; unknown versions are rejected at the boundary.",
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "score_delta": {
      "title": "Score Delta",
      "type": "number"
    }
  },
  "required": [
    "fork_t",
    "original_hash",
    "forked_hash",
    "diverged",
    "original_score",
    "forked_score",
    "score_delta"
  ],
  "title": "ForkResult",
  "type": "object",
  "x-skygym-schema-version": 3
}