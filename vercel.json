{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix frontend ci --include=dev --no-audit --no-fund && npm --prefix frontend run build && python backend/scripts/build_seed_snapshot.py",
  "regions": ["bom1"],
  "functions": {
    "server.py": {
      "maxDuration": 300,
      "memory": 2048,
      "includeFiles": "backend/data/seed_snapshot.db,frontend/dist/**",
      "excludeFiles": "{.venv/**,**/node_modules/**,.git/**,backend/tests/**,**/__pycache__/**,**/*.pyc,**/.pytest_cache/**,**/.mypy_cache/**,**/.ruff_cache/**,**/.hypothesis/**,backend/data/logs/**,backend/data/skygym.db*,backend/data/migrations_tmp/**,docs/**}"
    }
  }
}
